---
interface Props {
  name: string;
  class?: string;
  label?: string;
}

const { name, class: className = 'h-[18px] w-[18px]', label } = Astro.props;
const paths: Record<string, string[]> = {
  pin: ['M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z', 'M12 10a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z'],
  network: ['M12 5a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z', 'M5 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z', 'M19 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z', 'M10.5 4.5 6.5 17', 'm13.5 4.5 4 12.5', 'M8 19h8'],
  route: ['M6 19h9a4 4 0 0 0 0-8H9a4 4 0 0 1 0-4-4', 'm16 5 3-3 3 3', 'M19 2v5'],
  check: ['m5 12 4 4L19 6'],
  compass: ['M16.2 7.8 14 14l-6.2 2.2L10 10l6.2-2.2Z', 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z'],
  education: ['m2 10 10-5 10 5-10 5L2 10Z', 'M6 12v5c3 2 9 2 12 0v-5', 'M22 10v6'],
  wrench: ['M14.7 6.3a4 4 0 0 0-5-5L7 4l-3-1-3 3 1 3-2.7 2.7a4 4 0 0 0 5 5L15 6l-.3.3Z', 'm13 11 8 8a1.4 1.4 0 0 1-2 2l-8-8'],
  terminal: ['m4 17 6-6-6-6', 'M12 19h8'],
  code: ['m8 9-4 3 4 3', 'm16 9 4 3-4 3', 'm14 5-4 14'],
  panels: ['M3 4h18v16H3z', 'M3 9h18', 'M9 9v11'],
  share: ['M18 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z', 'M6 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z', 'M18 22a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z', 'm8.6 13.5 6.8-4', 'm8.6 16.5 6.8 4'],
  database: ['M20 5c0 1.7-3.6 3-8 3S4 6.7 4 5s3.6-3 8-3 8 1.3 8 3Z', 'M4 5v7c0 1.7 3.6 3 8 3s8-1.3 8-3V5', 'M4 12v7c0 1.7 3.6 3 8 3s8-1.3 8-3v-7'],
  external: ['M15 3h6v6', 'M10 14 21 3', 'M18 13v7H4V6h7'],
  sun: ['M12 4V2', 'M12 22v-2', 'm4.93 4.93-1.42-1.42', 'm20.49 20.49-1.42-1.42', 'M4 12H2', 'M22 12h-2', 'm6.34 17.66-1.41 1.41', 'm19.07 4.93-1.41 1.41', 'M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z'],
  moon: ['M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z'],
};

const isGithub = name === 'github';
---

<svg
  viewBox="0 0 24 24"
  class={className}
  fill={isGithub ? 'currentColor' : 'none'}
  stroke={isGithub ? 'none' : 'currentColor'}
  stroke-width="1.7"
  stroke-linecap="square"
  stroke-linejoin="miter"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {isGithub ? (
    <path d="M12 .8a11.2 11.2 0 0 0-3.5 21.8c.6.1.8-.2.8-.6v-2.2c-3.4.7-4.1-1.4-4.1-1.4-.6-1.4-1.4-1.8-1.4-1.8-1.1-.8.1-.8.1-.8 1.2.1 1.9 1.2 1.9 1.2 1 1.9 2.6 1.3 3.2 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.4-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C16.7 5 17.7 5.3 17.7 5.3c.6 1.6.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.5-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2V22c0 .4.2.7.8.6A11.2 11.2 0 0 0 12 .8Z" />
  ) : (
    paths[name]?.map((d) => <path d={d} />)
  )}
</svg>
